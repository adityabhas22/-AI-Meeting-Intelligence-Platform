# Copy to .env and fill in. Never commit .env.

# --- Speech to text + diarization ---
# https://console.deepgram.com  (Project > API Keys)
DEEPGRAM_API_KEY=

# --- LLM: extraction, summary, embeddings, and the Agents SDK loop ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Used for structured extraction (Responses API) + the agent's reasoning loop.
# gpt-5.5 is the current default; drop to gpt-4o if your account lacks access.
OPENAI_MODEL=gpt-5.5
# Used for archive embeddings. 1536 dims (text-embedding-3-small) keeps pgvector lean.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database (Postgres + pgvector) ---
# Local docker default below; swap for a hosted URL in prod.
DATABASE_URL=postgresql+psycopg://meeting:meeting@localhost:5432/meeting_intel

# --- App ---
# Where the Next.js frontend reaches the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Max upload size in MB (guard rail on the upload route).
MAX_UPLOAD_MB=200
